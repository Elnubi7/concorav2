APP_ENV=local
APP_NAME=gemma-chatbot-api
APP_VERSION=0.1.0
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=
REDIS_URL=
POSTGRES_USER=gemma
POSTGRES_PASSWORD=gemma
POSTGRES_DB=gemma
POSTGRES_PORT=5432
REDIS_PORT=6379
OPENAI_API_KEY=
LLM_PROVIDER=github_models
GITHUB_TOKEN=
GITHUB_MODELS_BASE_URL=https://models.github.ai/inference
LLM_MODEL=openai/gpt-4.1-mini
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=0
LLM_MAX_TOKENS=180
LLM_TEMPERATURE=0.4
SIMPLE_CHAT_MODE=true
HYBRID_ROUTER_MODE=deterministic
COMPLEXITY_THRESHOLD=0.65
ENABLE_LANGGRAPH=true
ENABLE_RESOURCE_RAG=true
ENABLE_RAG=false
ENABLE_MEMORY=false
ENABLE_DB=false
ENABLE_REDIS=false
ALWAYS_FAST_CHAT=false
LLM_FAST_MAX_TOKENS=120
LLM_FAST_TEMPERATURE=0.4
LLM_FAST_TIMEOUT_SECONDS=30
EMBEDDING_PROVIDER=disabled
EMBEDDING_MODEL=disabled
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_DIMENSIONS=0
VECTOR_BACKEND=disabled
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=gemma-chatbot
LOG_LEVEL=INFO
JWT_SECRET_KEY=local-dev-secret-change-me
CORS_ALLOWED_ORIGINS=*
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RAG_TOP_K=3
RAG_SCORE_THRESHOLD=0.2
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
RAG_MAX_DOCUMENT_SIZE=5000000
RESOURCE_RAG_MAX_DEFAULT=1
RESOURCE_RAG_MAX_EXPLICIT=3
RESOURCE_RAG_STRONG_MATCH_THRESHOLD=0.78
RESOURCE_RAG_PERMISSION_THRESHOLD=0.55
RESOURCE_RAG_MIN_TURNS_BEFORE_SUGGEST=3
RESOURCE_RAG_MIN_DEPTH_BEFORE_RECOMMEND=0.75
RESOURCE_RAG_COOLDOWN_TURNS=5
RESOURCE_INTENT_CLASSIFIER=semantic
RESOURCE_INTENT_CLASSIFIER_MODEL=use_default_llm
RESOURCE_INTENT_CONFIDENCE_THRESHOLD=0.65
MEMORY_ENABLED=false
STREAMING_ENABLED=true
ALLOW_WILDCARD_CORS=false
ALLOW_PLACEHOLDER_LOCAL_API_KEYS=false
ARCHIVE_DELETED_SESSIONS=true
